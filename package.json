{
  "name": "factory-dashboard-flow-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Factory Dashboard & Flow Hub V1 - offline gap-first lean cell design workbook analyser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "verify": "npm run typecheck && npm test && npm run build:offline && npm run test:e2e"
  },
  "dependencies": {
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4",
    "typescript": "5.6",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
